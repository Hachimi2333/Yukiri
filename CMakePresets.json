{
	"version": 8,
	"cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"cacheVariables": {
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
				"CMAKE_EXPORT_COMPILE_COMMANDS": true
			}
		},
		{ "name": "msvc-debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" } },
		{ "name": "msvc-release", "inherits": "msvc-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
		{ "name": "mingw-debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" } },
		{ "name": "mingw-release", "inherits": "mingw-debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
	],
	"buildPresets": [
		{ "name": "msvc-debug", "configurePreset": "msvc-debug" },
		{ "name": "msvc-release", "configurePreset": "msvc-release" },
		{ "name": "mingw-debug", "configurePreset": "mingw-debug" },
		{ "name": "mingw-release", "configurePreset": "mingw-release" }
	],
	"testPresets": [
		{ "name": "msvc-debug", "configurePreset": "msvc-debug", "output": { "outputOnFailure": true } },
		{ "name": "msvc-release", "configurePreset": "msvc-release", "output": { "outputOnFailure": true } },
		{ "name": "mingw-debug", "configurePreset": "mingw-debug", "output": { "outputOnFailure": true } },
		{ "name": "mingw-release", "configurePreset": "mingw-release", "output": { "outputOnFailure": true } }
	]
}
