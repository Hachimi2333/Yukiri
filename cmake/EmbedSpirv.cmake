file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" length)
math(EXPR remainder "${length} % 8")
if(NOT remainder EQUAL 0)
	message(FATAL_ERROR "SPIR-V must contain complete 32-bit words")
endif()
set(result "#pragma once\n#include <cstdint>\nnamespace Yukiri::Detail\n{\ninline constexpr std::uint32_t ${NAME}[] =\n{\n")
set(index 0)
while(index LESS length)
	string(SUBSTRING "${bytes}" ${index} 2 b0)
	math(EXPR offset "${index} + 2")
	string(SUBSTRING "${bytes}" ${offset} 2 b1)
	math(EXPR offset "${index} + 4")
	string(SUBSTRING "${bytes}" ${offset} 2 b2)
	math(EXPR offset "${index} + 6")
	string(SUBSTRING "${bytes}" ${offset} 2 b3)
	string(APPEND result "\t0x${b3}${b2}${b1}${b0},\n")
	math(EXPR index "${index} + 8")
endwhile()
string(APPEND result "};\n}\n")
file(WRITE "${OUTPUT}" "${result}")
